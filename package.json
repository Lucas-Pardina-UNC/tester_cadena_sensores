{
  "name": "sensor_chain_tester",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "lh_software_dev_lp",
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:preload && npm run transpile:electron && cross-env NODE_ENV=development electronmon .",
    "build": "pyinstaller --noconfirm --onefile --distpath src/electron/backend --specpath src/electron/backend --paths src/electron/backend src/electron/backend/app.py && tsc -b && vite build && electron-builder",
    "postbuild": "node scripts/build-python-installer.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "transpile:preload": "tsc --project src/electron/tsconfig.preload.json",
    "dist:mac": "npm run transpile:electron && npm run build && electron-builder --mac --arm64",
    "dist:linux": "npm run transpile:electron && npm run build && electron-builder --linux --x64",
    "dist:win": "npm run transpile:electron && npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite-tsconfig-paths": "^5.1.4",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/electron": "^1.6.12",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^7.0.3",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.82.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
